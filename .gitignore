# ============================================================
# Root .gitignore — Desktop Tracking System monorepo
# Covers: Desktop Agent (Java), Backend (Spring Boot), Frontend (React/Vite)
# ============================================================

# ---------- Java / Maven / Spring Boot ----------
target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
*.log
*.log.*
*.tmp
*.temp
*.orig
*.rej
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---------- Maven wrapper (keep mvnw, ignore wrapper jar) ----------
.mvn/wrapper/maven-wrapper.jar

# ---------- Node / React / Vite ----------
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# ---------- Environment files ----------
.env
.env.*
!.env.example
!.env.sample

# ---------- Logs ----------
logs/
*.log
*.err.log
*.out.log
*.err
*.out
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- SQLite databases ----------
*.db
*.db-shm
*.db-wal
*.db.bak
*.sqlite
*.sqlite3

# ---------- IDE / Editor ----------
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/terminals.json

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
.idea_modules/

# Eclipse / STS
.classpath
.project
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/
build/

# ---------- Windows / OS generated ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~
._*

# ---------- Temporary / cache ----------
*.tmp
*.temp
*.cache
.cache/
.tmp/
temp/
*.bak
*.orig
*.rej
*.swp
*.swo

# ---------- Test / coverage ----------
coverage/
.nyc_output/
*.lcov
junit.xml
test-results/
surefire-reports/
target/surefire-reports/

# ---------- QA / artifact folders ----------
qa/

# ---------- GitHub (allow standard automation files, ignore agent tooling) ----------
.github/*
!.github/CODEOWNERS
!.github/dependabot.yml
!.github/LABELS.md
!.github/PULL_REQUEST_TEMPLATE.md
!.github/workflows/
!.github/workflows/**
!.github/ISSUE_TEMPLATE/
!.github/ISSUE_TEMPLATE/**



# ---------- Misc ----------
*.pid
*.seed
*.pid.lock
.DS_Store
